# --- Color Cycle ---
axes.prop_cycle : cycler('color', ['7760FB', '5CAD70', 'D95F02', 'E7298A', 'E6AB02', 'A6761D', 'D9D9D9'])

# --- Figure ---
figure.figsize      : 8, 5
figure.dpi          : 150
figure.facecolor    : white
figure.edgecolor    : white

# --- Axes ---
axes.facecolor      : white
axes.edgecolor      : D9D9D9
axes.linewidth      : 1.2
axes.labelcolor     : black
axes.labelsize      : 11
axes.titlesize      : 13
axes.titleweight    : bold
axes.titlepad       : 10
axes.spines.top     : False
axes.spines.right   : False
axes.grid           : True

# --- Grid ---
grid.color          : D9D9D9
grid.linestyle      : --
grid.linewidth      : 0.7
grid.alpha          : 0.7

# --- Ticks ---
xtick.color         : black
ytick.color         : black
xtick.labelsize     : 10
ytick.labelsize     : 10
xtick.direction     : out
ytick.direction     : out
xtick.major.size    : 4
ytick.major.size    : 4
xtick.minor.visible : False
ytick.minor.visible : False

# --- Legend ---
legend.frameon      : True
legend.framealpha   : 0.9
legend.edgecolor    : D9D9D9
legend.fontsize     : 10
legend.title_fontsize: 11

# --- Lines ---
lines.linewidth     : 2.0
lines.markersize    : 6

# --- Patches (bars, filled areas, etc.) ---
patch.edgecolor     : none
patch.linewidth     : 0.5

# --- Fonts ---
font.family         : sans-serif
font.sans-serif     : DejaVu Sans, Arial, Helvetica, sans-serif
font.size           : 11

# --- Saving ---
savefig.dpi         : 200
savefig.bbox        : tight
savefig.facecolor   : white